# ─────────────────────────────────────────────────────────────────────────────
# Zero Hunger Monorepo — Root .gitignore
# Each sub-project (frontend/, admin/, backend/) also has its own .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Dependencies (all sub-projects)
node_modules/
**/node_modules/

# Build outputs
dist/
dist-ssr/
**/dist/

# Environment — NEVER commit real secrets
.env
.env.*
!**/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Lock files (handled per-project)
bun.lock

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript build info
*.tsbuildinfo
